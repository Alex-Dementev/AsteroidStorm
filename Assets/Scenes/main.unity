  m_Text: "\u043F\u043E\u0441\u043B\u0435 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F,
    \u043F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u043B\u044E\u0431\u043E\u0439
    \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0438
    5\u0441\u0435\u043A, \n\u044D\u043D\u0435\u0440\u0433\u0438\u044F: 10    \u043E\u0442\u043A\u0430\u0442:
    10\u0441\u0435\u043A"
