    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 45
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 74
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u0438\u0433\u0440\u0430
    \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0430\u0441\u044C \u043A\u0430\u043A
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 \u0440\u0430\u043D\u043D\u0435\u0440
    \u0441\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E.\n\u041F\u0440\u043E\u0435\u043A\u0442
    \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0437\u0430 3 \u043C\u0435\u0441\u044F\u0446\u0430
    \u043E\u0434\u043D\u0438\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C
    \u2014 \u043C\u043D\u043E\u0439, MrGameDragon2011.\n\n\u0421\u043F\u0443\u0441\u0442\u044F
    6 \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F
    \u044F \u0440\u0435\u0448\u0438\u043B \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u041C\u0410\u0421\u0421\u041E\u0412\u0423\u042E \u0414\u041E\u0420\u0410\u0411\u041E\u0422\u041A\u0423!\n\n\u041D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0438\u0433\u0440\u0430 \u043F\u043E\u0434\u0430\u0440\u0438\u0442 \u0432\u0430\u043C
    \u044F\u0440\u043A\u0438\u0435 \u044D\u043C\u043E\u0446\u0438\u0438 \u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0441\u044F!\n\u042D\u0442\u043E
    \u043C\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
    \u043F\u0440\u043E\u0435\u043A\u0442, \u043D\u0435 \u0441\u0443\u0434\u0438\u0442\u0435
    \u0441\u0442\u0440\u043E\u0433\u043E :)"
