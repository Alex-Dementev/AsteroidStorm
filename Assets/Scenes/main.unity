    m_LineSpacing: 1
  m_Text: "\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u0432\u0437\u0440\u044B\u0432 \u043F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
    \u0441 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043E\u043C, \u0432\u0437\u0440\u044B\u0432
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
    (\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0443),
    \n\u044D\u043D\u0435\u0440\u0433\u0438\u044F: 60    \u043E\u0442\u043A\u0430\u0442:
    50\u0441\u0435\u043A"
