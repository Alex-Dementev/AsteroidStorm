  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 0.3537736, b: 0.9072189, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 4
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u042D\u0442\u0430 \u0440\u0430\u043A\u0435\u0442\u0430 \u2014 \u043A\u0430\u043A
    \u043D\u043E\u0432\u043E\u0433\u043E\u0434\u043D\u0435\u0435 \u0447\u0443\u0434\u043E:
    \u0433\u043E\u0440\u0438\u0442, \u043B\u0435\u0442\u0438\u0442 \u0438 \u0438\u043D\u043E\u0433\u0434\u0430
    \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u0430\u043A,
    \u0447\u0442\u043E \u0421\u0430\u043D\u0442\u0430 \u043D\u0435\u0440\u0432\u043D\u043E
    \u043A\u0443\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u043A\u0435.
    \u0418\u0433\u0440\u0443\u0448\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
    \u043D\u0430 \u0447\u0435\u0441\u0442\u043D\u043E\u043C \u0441\u043B\u043E\u0432\u0435,
    \u0433\u0438\u0440\u043B\u044F\u043D\u0434\u0430 \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u044F\u0434\u0435\u0440\u043D\u043E\u0433\u043E \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430,
    \u0430 \u0437\u0430\u043F\u0430\u0445 \u0445\u0432\u043E\u0438 \u2014 \u044D\u0442\u043E,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0434\u044B\u043C."
