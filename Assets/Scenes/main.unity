    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u0442
    \u0432\u0441\u0435 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u044B \u0432
    \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u0435, \u0430 \u0435\u0451 \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \xAB\u044D\u0445, \u0438\u043C\u043F\u043E\u0441\u0442\u043E\u0440,
    \u043D\u0443 \u0442\u044B \u0438\u2026\xBB. \u041A\u0440\u0430\u0441\u043D\u0430\u044F,
    \u0431\u044B\u0441\u0442\u0440\u0430\u044F \u0438 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0433\u043E\u0442\u043E\u0432\u0430 \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0430
    \u043A\u043D\u043E\u043F\u043A\u0443. \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0439
    \u0447\u0442\u043E\u0431 \u0431\u044B\u043B\u043E \u043D\u043E\u0440\u043C"
