--- !u!114 &1337588809
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1337588807}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042F \u043E\u0442\u043A\u0440\u044B\u043B \u043F\u0430\u043D\u0435\u043B\u044C
    \u043F\u0438\u0442\u043E\u043C\u0446\u0435\u0432. \u0422\u0443\u0442 \u0447\u0442\u043E,
    \u043E\u043F\u044F\u0442\u044C \u0441\u043B\u043E\u0442\u044B? "
  - "\u0422\u0443\u0442 \u0441\u043B\u043E\u0442\u044B \u2014 \u044D\u0442\u043E
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u0438\u0445 \u043F\u043E\u0434\u044A\u0451\u043C
    \u0432 \u043D\u0435\u0431\u043E. \u0411\u0435\u0437 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438
    \u043D\u0435\u043B\u044C\u0437\u044F \u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C. "
  - "\u0410 \u0432\u043E\u043E\u0431\u0449\u0435 \u0447\u0442\u043E \u043F\u0438\u0442\u043E\u043C\u0435\u0446
    \u0434\u0435\u043B\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u0442?"
  - "\u041F\u0438\u0442\u043E\u043C\u0435\u0446 \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u0431\u044F
    \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0442\u044C \u0432\u0435\u0441\u044C
    \u0432\u044B\u043B\u0435\u0442, \u0430 \u043F\u043E\u0441\u043B\u0435 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F. "
  - "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u043E\u0434\u0430\u0442\u044C
    \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0431\u0435\u0440\u0438
    \u0435\u0433\u043E \u0438 \u043F\u0440\u043E\u0434\u0430\u0439 (2 \u043D\u0430\u0436\u0430\u0442\u0438\u044F
    \u043F\u043E \u043D\u0435\u043C\u0443). "
  - "\u041D\u0443, \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E. \u0417\u0432\u0443\u0447\u0438\u0442
    \u043C\u043D\u043E\u0433\u043E\u043E\u0431\u0435\u0449\u0430\u044E\u0449\u0435! "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  - "\u041D\u0438\u043A\u0438\u0442\u0430"
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  - "\u041D\u0438\u043A\u0438\u0442\u0430"
  - "\u0420\u043E\u043C\u0430"
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
