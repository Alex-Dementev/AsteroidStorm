--- !u!114 &1640732484
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1640732483}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u041A\u043E\u0440\u043E\u0447\u0435, \u044D\u0442\u0430 \u0445\u0440\u0435\u043D\u043E\u0432\u0438\u043D\u0430
    \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0430 15 000. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043A\u043B\u044F\u043D\u0443\u0442\u0441\u044F,
    \u0447\u0442\u043E \u043E\u043D\u0430 \u0432\u044B\u0442\u0430\u0449\u0438\u0442
    \u0442\u0435\u0431\u044F \u0438\u0437 \u043B\u044E\u0431\u043E\u0439 \u0442\u043E\u0447\u043A\u0438
    \u0438 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
  - "\u041F\u043E\u043A\u0430 \u0442\u044B \u043B\u0435\u0442\u0430\u043B, \u043C\u044B
    \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043C\u0430\u044F\u043A-\u0442\u043E\u0447\u043A\u0443.
    \u0414\u043E\u0441\u0442\u0430\u0432\u0438\u043C \u0442\u0435\u0431\u044F \u0441\u0440\u0430\u0437\u0443
    \u043A \u043D\u0435\u0439, \u043E\u0442\u0442\u0443\u0434\u0430 \u043B\u0435\u0442\u0438\u0448\u044C
    \u0432 \u0434\u044B\u0440\u0443 \u0441\u0430\u043C."
  - "\u0410 \u043F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
    \u043C\u0430\u044F\u043A \u0431\u043B\u0438\u0436\u0435?"
  - "\u0411\u043B\u0438\u0436\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0431\u044B \u043D\u0435 \u0432\u044B\u0448\u043B\u043E \u2014 \u0442\u043E\u0447\u043A\u0443
    \u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0441\u043E\u0441\u0430\u043B\u043E
    \u0438 \u0441\u0432\u044F\u0437\u044C \u0431\u044B \u043F\u0440\u043E\u043F\u0430\u043B\u0430.
    \u041D\u043E \u0443\u0447\u0442\u0438: \u0437\u0430\u0431\u0440\u043E\u0441 \u0432\u044B\u0448\u0435\u043B
    \u0437\u0430\u0442\u0440\u0430\u0442\u043D\u044B\u043C, \u0442\u0430\u043A \u0447\u0442\u043E
    \u0432\u044B\u043B\u0435\u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u043E\u0440\u043E\u0436\u0435."
  - "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C\u0441\u044F
    \u0432 \u0441\u0430\u043C\u044B\u0439 \u044D\u043F\u0438\u0446\u0435\u043D\u0442\u0440,
    \u043D\u0430\u0439\u0442\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u0438 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u0442\u044C
    \u0435\u0433\u043E."
  - "\u0414\u0430\u0432\u0430\u0439, \u0410\u043B\u0435\u043A\u0441\u0435\u0439.
    \u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u043C \u044D\u0442\u0443 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044E
    \u0440\u0430\u0437 \u0438 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  - "\u0418 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435 \u0442\u0430\u043C!"
  - 
