    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0440\u0430\u043A\u0435\u0442\u0430
    \u0434\u043B\u044F \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439.
    \u041B\u0435\u0442\u0438\u0442 \u043F\u0440\u044F\u043C\u043E\u2026 \u043F\u043E\u043A\u0430
    \u043D\u0435 \u0440\u0435\u0448\u0438\u0442, \u0447\u0442\u043E \u043F\u0440\u044F\u043C\u043E
    \u2014 \u044D\u0442\u043E \u0432 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434."
