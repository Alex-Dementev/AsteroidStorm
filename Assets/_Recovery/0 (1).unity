  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0443\u0442 \u043F\u0430\u043D\u0435\u043B\u044C \u0431\u0443\u0441\u0442\u043E\u0432,
    \u0442\u0438\u043F\u0430 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0430? "
  - "\u0414\u0430, \u0442\u0443\u0442 \u0442\u044B \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0448\u044C\u0441\u044F. "
  - 
  - "\u0418 \u0432\u0441\u0451? \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u043C
    \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F? "
  - "\u041D\u0435\u0442."
  - "\u041D\u0443 \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0442\u0435\u043C\u044B..."
  - "\u0417\u0430\u0446\u0435\u043D\u0438\u0442\u0435 \u0448\u0443\u0442\u043A\u0443:
    \u041A\u043E\u043B\u043E\u0431\u043E\u043A \u043F\u043E\u0432\u0435\u0441\u0438\u043B\u0441\u044F!"
  - "\u041B\u0430\u0434\u043D\u043E, \u043B\u0443\u0447\u0448\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043C. "
