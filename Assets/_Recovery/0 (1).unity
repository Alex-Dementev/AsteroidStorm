--- !u!114 &1320654603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1320654601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0430\u043A... \u044F \u0432 \u043C\u043E\u0434\u0443\u043B\u044F\u0445.
    \u0422\u0443\u0440\u0431\u0438\u043D\u0430 \u0435\u0441\u0442\u044C. \u0427\u0442\u043E
    \u0434\u0430\u043B\u044C\u0448\u0435?"
  - "\u0422\u0443\u0442 \u0436\u0435 \u0432\u0441\u0451 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E!
    \u041D\u0443 \u0442\u044B \u0431\u043B\u0438\u043D..."
  - "\u0422\u0443\u0440\u0431\u0438\u043D\u0430 \u2014 \u044D\u0442\u043E \u043C\u043E\u0434\u0443\u043B\u044C.
    \u041D\u043E \u043C\u043E\u0434\u0443\u043B\u044C \u043D\u0435\u043B\u044C\u0437\u044F
    \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C, \u0435\u0441\u043B\u0438
    \u043F\u043E\u0434 \u043D\u0435\u0433\u043E \u043D\u0435 \u043A\u0443\u043F\u043B\u0435\u043D
    \u0441\u043B\u043E\u0442. "
  - "\u0421\u043B\u043E\u0442? \u042F \u0434\u0443\u043C\u0430\u043B, \u043E\u043D\u0430
    \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F. "
  - "\u0421\u043B\u043E\u0442 \u2014 \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u0430 \u0442\u0430\u043A
    \u2014 \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u0441\u0442\u043E
    \u043F\u043E\u0434 \u043C\u043E\u0434\u0443\u043B\u0438. \u0415\u0433\u043E \u043D\u0443\u0436\u043D\u043E
    \u043A\u0443\u043F\u0438\u0442\u044C, \u0442\u043E \u0435\u0441\u0442\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u043C \u0434\u043B\u044F \u043C\u043E\u0434\u0443\u043B\u044F. "
  - "\u0418\u043D\u0430\u0447\u0435 \u0440\u0430\u043A\u0435\u0442\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443!"
  - "\u041D\u0435 \u0442\u0443\u043F\u0438! \u041F\u0440\u043E\u0441\u0442\u043E
    \u043A\u0443\u043F\u0438 \u0441\u043B\u043E\u0442 \u0434\u043B\u044F \u0442\u0443\u0440\u0431\u0438\u043D\u044B
    \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0435\u0451 \u0442\u0443\u0434\u0430! "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
