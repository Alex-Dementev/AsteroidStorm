--- !u!114 &736983841
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 736983839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0430\u043A... \u0434\u0435\u043D\u044C\u0433\u0438 \u0435\u0441\u0442\u044C.
    \u041D\u0435\u043D\u0430\u0432\u0438\u0436\u0443 \u0434\u043E\u043B\u0433\u0438,
    \u043D\u043E \u043B\u0430\u0434\u043D\u043E!"
  - "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043D\u0435 \u0442\u0443\u043F\u0438 \u2014 \u0431\u0435\u0440\u0438: \xAB\u0422\u0443\u0440\u0431\u0438\u043D\u0430
    1\xBB. "
  - "\xAB\u0422\u0443\u0440\u0431\u0438\u043D\u0430 1\xBB, \u043F\u043E\u043D\u044F\u043B.
    \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E? "
  - "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u0432\u0437\u043B\u0435\u0442\u0438, \xAB\u0413\u0435\u0440\u043E\u0439\xBB. "
  - "\u0414\u0435\u0432\u043E\u0447\u043A\u0438, \u043D\u0435 \u0441\u0441\u043E\u0440\u044C\u0442\u0435\u0441\u044C!"
  - "\u0425\u0430-\u0445\u0430-\u0445\u0430!"
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
