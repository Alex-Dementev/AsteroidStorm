  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042F \u043E\u0442\u0434\u0430\u043B \u043A\u0440\u0435\u0434\u0438\u0442...
    \u0427\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435? "
  - "\u041D\u0435 \u0437\u043D\u0430\u044E... \u041D\u0443, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0432 \u043A\u0430\u0437\u0438\u043D\u043E \u0441\u0445\u043E\u0434\u0438? "
  - "\u0427\u0442\u043E?"
  - "\u0427\u0442\u043E?"
  - "\u042F \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u0434\u0430\u043B \u043A\u0440\u0435\u0434\u0438\u0442,
    \u0438 \u0442\u044B \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C
    \u0432 \u043A\u0430\u0437\u0438\u043D\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C?? "
  - "\u041D\u0435\u0442... \u044F \u043D\u0435 \u044D\u0442\u043E \u0438\u043C\u0435\u043B
    \u0432 \u0432\u0438\u0434\u0443..."
  - "\u0414\u0430 \u0442\u044B \u0433\u0435\u043D\u0438\u0439!"
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
