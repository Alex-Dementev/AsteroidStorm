  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042F \u043A\u0443\u043F\u0438\u043B \u0442\u0443\u0440\u0431\u0438\u043D\u0443."
  - "\u041D\u0443 \u0442\u0430\u043A \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0435\u0451,
    \u043E\u043D\u0430 \u0441\u0430\u043C\u0430 \u0441\u0435\u0431\u044F \u043A \u0440\u0430\u043A\u0435\u0442\u0435
    \u043D\u0435 \u043F\u0440\u0438\u043A\u0440\u0443\u0442\u0438\u0442! "
  - "\u0410\u0433\u0430\u2026 \u0438 \u0433\u0434\u0435 \u0435\u0451 \u0432\u043E\u043E\u0431\u0449\u0435
    \u0441\u0442\u0430\u0432\u0438\u0442\u044C? "
  - "\u041D\u0435 \u0442\u0443\u043F\u0438, \u0437\u0430\u0439\u0434\u0438 \u0432
    \u043C\u043E\u0434\u0443\u043B\u0438. \u0422\u0430\u043C \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u0432\u0441\u044F \u0440\u0430\u043A\u0435\u0442\u0430."
  - "\u0414\u0430\u0432\u0430\u0439, \u043D\u0435 \u0442\u044F\u043D\u0438. \u0411\u0435\u0437
    \u043D\u0435\u0451 \u0442\u044B \u0434\u0430\u0436\u0435 \u0432\u0437\u043B\u0435\u0442\u0435\u0442\u044C
    \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C! "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
