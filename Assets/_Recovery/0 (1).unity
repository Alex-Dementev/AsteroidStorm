--- !u!114 &1041971596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1041971594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u041B\u0430\u0434\u043D\u043E\u2026 \u043F\u043E\u0445\u043E\u0436\u0435, \u043C\u043D\u0435
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u043C\u0443
    \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u044D\u0442\u0443 \u0447\u0451\u0440\u0442\u043E\u0432\u0443
    \u0440\u0430\u043A\u0435\u0442\u0443. \u0421 \u0447\u0435\u0433\u043E \u043D\u0430\u0447\u0430\u0442\u044C
    \u0441\u0431\u043E\u0440\u043A\u0443?"
  - "\u0422\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E
    \u0442\u044B \u0448\u0430\u0440\u0438\u0448\u044C \u0432 \u044D\u0442\u043E\u0439
    \u0442\u0435\u043C\u0435!"
  - "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u0430 \u0442\u0443\u0440\u0431\u0438\u043D\u0430,
    \u0431\u0435\u0437 \u043D\u0435\u0435 \u0440\u0430\u043A\u0435\u0442\u0430 \u043D\u0435
    \u043F\u043E\u043B\u0435\u0442\u0438\u0442..."
  - "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u043D\u0435 \u043A\u0438\u043F\u044F\u0442\u0438\u0441\u044C,
    \u044F \u0442\u043E\u0436\u0435 \u043D\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
    \u0443\u043C\u0435\u044E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u0430\u043A\u0435\u0442\u044B,
    \u043D\u043E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u043C\u043D\u0435
    \u043B\u0435\u0433\u043A\u043E \u0434\u0430\u044E\u0442\u0441\u044F!"
  - "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D
    \u0438 \u043A\u0443\u043F\u0438 \xAB\u0422\u0443\u0440\u0431\u0438\u043D\u0430
    1\xBB, \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443. "
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
