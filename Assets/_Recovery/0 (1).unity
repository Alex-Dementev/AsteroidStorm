  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0412\u0438\u0436\u0443, \u0443 \u0442\u0435\u0431\u044F \u043E\u0431\u043D\u043E\u0432\u043A\u0430? "
  - "\u0410\u0445\u0430\u0445. \u0411\u0435\u0437 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430,
    \u0441 \u0433\u043E\u0434\u043E\u043C, \u0441 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0451\u043C. "
  - "\u0410 \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043E
    \u0441\u0442\u0430\u0440\u044B\u043C\u0438 \u043C\u043E\u0434\u0443\u043B\u044F\u043C\u0438? "
  - "\u0421\u043D\u0438\u043C\u0430\u0442\u044C \u0448\u0442\u0430\u043D\u044B \u0438
    \u0431\u0435\u0433\u0430\u0442\u044C... "
  - "\u041F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0434\u0435\u043B\u0438 \u043C\u043E\u0434\u0443\u043B\u044C
    (2 \u043D\u0430\u0436\u0430\u0442\u0438\u044F \u043F\u043E \u043C\u043E\u0434\u0443\u043B\u044E)
