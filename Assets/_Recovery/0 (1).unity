--- !u!114 &1000700719
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1000700718}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042D\u0442\u0430 \u0447\u0451\u0440\u043D\u0430\u044F \u0434\u044B\u0440\u0430
    \u2014 \u0432 \u0440\u0430\u0437\u044B \u0445\u0443\u0436\u0435 \u043B\u044E\u0431\u044B\u0445
    \u043F\u0440\u043E\u0433\u043D\u043E\u0437\u043E\u0432."
  - "\u041B\u0435\u0442\u0435\u0442\u044C \u0442\u0443\u0434\u0430 \u043F\u0440\u044F\u043C\u043E
    \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u044D\u0442\u043E \u0442\u0443\u043F\u043E
    \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E. \u0411\u0435\u0437
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432."
  - "\u0417\u0430\u0442\u043E \u043A\u0430\u043A\u043E\u0432 \u043C\u0430\u0441\u0448\u0442\u0430\u0431!
    \u0423 \u043D\u0430\u0441 \u0432 \u0448\u0442\u0430\u0431\u0435 \u0434\u0430\u0436\u0435
    \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0444\u043E\u043D\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u0438, \u043F\u043E\u043A\u0430 \u0442\u044B \u0440\u044F\u0434\u043E\u043C
    \u0441\u043C\u043E\u0442\u0440\u0435\u043B."
  - "\u041D\u0443\u0436\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F,
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043B\u0435\u0442\u0435\u0442\u044C
    \u0432 \u044D\u043F\u0438\u0446\u0435\u043D\u0442\u0440."
  - "\u0417\u0430\u0439\u0434\u0438 \u0432 \u0430\u0447\u0438\u0432\u043A\u0438,
    \u0442\u0430\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C. \u041D\u0435\u0442
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C,
    \u043D\u043E \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0434\u0435\u043D\u0435\u0433!"
  - 
