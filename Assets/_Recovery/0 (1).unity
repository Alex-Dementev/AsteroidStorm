--- !u!114 &71569275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 71569272}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u041F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043A\u043E\u043A\u043E\u0439-\u0442\u043E
    \xAB\u041A\u0440\u0438\u0441\u0442\u0430\u043B\xBB..."
  - "\u0421\u043C\u043E\u0442\u0440\u044E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435...
    \u041D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
    \u043D\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E."
  - "\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u043D\u0430 \u0447\u0442\u043E?"
  - "\u041D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435 \u043F\u043E\u043B\u0451\u0442\u044B.
    \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0435\u0441\u043B\u0438 \u0442\u044B
    \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\u0441\u044F
    \u043A \u0447\u0451\u0440\u043D\u043E\u0439 \u0434\u044B\u0440\u0435."
  - "\u0422\u043E \u0435\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A
    \u0442\u0443\u0434\u0430 \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043B\u0435\u0442\u0438\u0448\u044C?"
  - "\u041D\u0435\u0442. \u0411\u0435\u0437 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
    \u0438 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0438
    \u2014 \u044D\u0442\u043E \u043A\u043E\u043D\u0435\u0446."
  - "\u0417\u043D\u0430\u0447\u0438\u0442, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0434\u0435\u043D\u044C\u0433\u0438."
  - "\u0414\u0430. \u0420\u0435\u0447\u044C \u0438\u0434\u0451\u0442 \u043E \u043C\u043E\u0434\u0443\u043B\u0435
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
  - "C\u0438\u0441\u0442\u0435\u043C\u0435 \u043A\u0432\u0430\u043D\u0442\u043E\u0432\u043E\u0439
    \u0442\u0435\u043B\u0435\u043C\u0435\u0442\u0440\u0438\u0438"
  - "\u0418 \u043A\u0430\u043D\u0430\u043B\u0435 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439
    \u0440\u0435\u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u0430."
  - "\u2026\u0427\u0435\u0433\u043E?"
  - "\u0422\u044B \u0441\u0430\u043C \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E
    \u0441\u043A\u0430\u0437\u0430\u043B?"
  - "\u041F\u043E-\u043F\u0440\u043E\u0441\u0442\u043E\u043C\u0443 \u2014 \u044D\u0442\u043E
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0443\u0436\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u0442\u0435\u0431\u044F
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E
    \u0438 \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F."
  - "\u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E
    \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0448\u044C."
  - "\u0418 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u0442?"
  - 12 000.
  - "\u0410, \u043D\u0443 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
    \u0412\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C 25 \u0442\u044B\u0441\u044F\u0447
    \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C
    \u043A \u0447\u0451\u0440\u043D\u043E\u0439 \u0434\u044B\u0440\u0435."
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  - "\u041D\u0438\u043A\u0438\u0442\u0430"
