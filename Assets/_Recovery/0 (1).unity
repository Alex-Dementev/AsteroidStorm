  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0412\u0441\u0451, \u0447\u0442\u043E \u044F \u0441\u043E\u0431\u0440\u0430\u043B
    \u2014 \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0434\u0430\u0442\u044C? "
  - "\u0414\u0430. \u0418\u043B\u0438 \u0442\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F
    \u043C\u0443\u0437\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C?
    \u041F\u0440\u044F\u043C \u043A\u0430\u043A \u043C\u043E\u0439 \u0434\u0440\u0443\u0433
    \u2014 \u0443 \u043D\u0435\u0433\u043E \u043A\u043E\u043D\u0444\u0435\u0442\u044B
    \u043B\u0435\u0436\u0430\u0442 \u0441 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
    \u0432\u0435\u043A\u0430\u2026 "
  - "\u0412 \u043B\u043E\u043C\u0431\u0430\u0440\u0434\u0435 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
    \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u043C\u0435\u0442\u0430\u043B\u043B\u044B
    \u0441 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043E\u0432 (\u0431\u0440\u043E\u043D\u0437\u0443,
    \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0437\u043E\u043B\u043E\u0442\u043E
    \u0438 \u0430\u043B\u043C\u0430\u0437\u044B). "
  - "\u0423\u0447\u0442\u0438, \u0446\u0435\u043D\u044B \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u0432
    \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043A\u0430\u0436\u0434\u044B\u0439
    \u0447\u0430\u0441. \u041C\u043E\u0436\u0435\u0442 \u043C\u0435\u0442\u0430\u043B\u043B
    \u043F\u043E\u0434\u043B\u0435\u0442\u0438\u0442, \u0430 \u043C\u043E\u0436\u0435\u0442
    \u0438 \u0443\u043F\u0430\u0434\u0451\u0442\u2026 "
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  - 
  - 
  - 
