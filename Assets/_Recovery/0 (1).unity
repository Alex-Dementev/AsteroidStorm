  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0443\u0440\u0431\u0438\u043D\u0430 \u0441\u0442\u043E\u0438\u0442. \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u044F \u043F\u043E\u043C\u043D\u044E, \u0434\u043B\u044F \u043D\u0435\u0451
    \u043D\u0443\u0436\u043D\u043E \u0442\u043E\u043F\u043B\u0438\u0432\u043E. "
  - "\u0410\u043C\u0435\u0440\u0438\u043A\u0443 \u043E\u0442\u043A\u0440\u044B\u043B..."
  - "\u0422\u043E\u043F\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435, \u043E\u043D\u043E \u0432\u0440\u043E\u0434\u0435
    \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u043E\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C! "
  - "\u0410 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C?"
  - "\u041A\u0443\u043F\u0438 5 \u043A\u0430\u043D\u0438\u0441\u0442\u0440, \u043D\u0430
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u044B\u043B\u0435\u0442 \u0445\u0432\u0430\u0442\u0438\u0442!"
