  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042D\u0442\u043E \u043E\u0441\u0442\u0440\u043E\u0432. \u0421\u043C\u043E\u0442\u0440\u0438,
    \u0442\u0443\u0442 \u0432\u0438\u0434\u043D\u043E \u0432\u0441\u0451, \u0447\u0442\u043E
    \u0442\u044B \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u0451\u043B! "
  - "\u041A\u0430\u0436\u0434\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043F\u0443\u0442\u0438
    \u2014 \u044D\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u043F\u0443\u0442\u0438. "
  - "\u0417\u043D\u0430\u0447\u0438\u0442 \u044F \u0432\u0441\u0435\u0433\u0434\u0430
    \u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043D\u0430 \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C?"
  - "\u0422\u044B \u0434\u0443\u0440\u0430\u043A? \u041C\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u0447\u0442\u043E \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B\u0438."
