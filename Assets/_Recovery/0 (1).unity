--- !u!114 &1494265526
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1494265524}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0430\u043A, \u044F \u0437\u0430\u0448\u0435\u043B \u0432 \u0431\u0430\u043D\u043A...
    \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435?
    \u0422\u0443\u0442 \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B,
    \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0438... \u0411\u044B\u0441\u0442\u0440\u043E
    \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0439\u0442\u0435!"
  - "\u0414\u0430 \u0443\u0436, \u041B\u0451\u0445\u0430, \u0442\u044B \u043F\u0440\u044F\u043C
    \xAB\u0432 \u0442\u0435\u043C\u0435\xBB\u2026 "
  - "\u041D\u0443, \u0442\u044B \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435
    \u0448\u0430\u0440\u0438\u0448\u044C\u2026 \u0427\u0451, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043A\u0440\u0435\u0434\u0438\u0442 \u043D\u0435 \u0431\u0440\u0430\u043B!? "
  - "\u041B\u0430\u0434\u043D\u043E \u0432\u0430\u043C, \u0437\u0430\u0442\u043E
    \u044F \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0432\u043B\u0435\u0437\u0430\u043B \u0432 \u0434\u043E\u043B\u0433\u0438\u2026 "
  - "\u0425\u0432\u0430\u0442\u0438\u0442 \u0431\u043E\u043B\u0442\u0430\u0442\u044C!
    \u041E\u0431\u044A\u044F\u0441\u043D\u044F\u044E: \u0440\u0435\u0439\u0442\u0438\u043D\u0433
    \u2014 \u044D\u0442\u043E \u0442\u0432\u043E\u0451 \u0432\u0441\u0451. \u041E\u0442
    \u043D\u0435\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u0440\u0430\u0437\u043C\u0435\u0440
    \u043A\u0440\u0435\u0434\u0438\u0442\u0430 \u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442! "
  - "\u0410 \u0435\u0441\u043B\u0438 \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u043D\u0438\u0437\u043A\u0438\u0439
    - \u043F\u0440\u0438\u0432\u0435\u0442 \u0431\u043E\u043B\u044C!"
  - "\u0410 \u043A\u0430\u043A \u0435\u0433\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C
    \u0438\u043B\u0438 \u0442\u0435\u0440\u044F\u0442\u044C?"
  - "\u041D\u0443, \u0442\u0435\u0431\u0435 \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0435\u0433\u043E \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C, \u0434\u0430\u0451\u0442\u0441\u044F
    \u043D\u0435\u0434\u0435\u043B\u044F. \u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0438\u0448\u044C
    \u2014 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \xAB\u0441\u043B\u0430\u0434\u043A\u0430\u044F
    \u0436\u0438\u0437\u043D\u044C\xBB, \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u0431\u0443\u0434\u0435\u0442 \u043C\u0430\u043B\u043E! "
  - "\u0422\u043E \u0435\u0441\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C,
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0438\u0442\u044C,
    \u043D\u043E \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C,
    \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
    \u0435\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0440\u043E\u043A\u0430. "
  - "\u041F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
    \u0437\u0430 \u0440\u0430\u0437, \u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C
    \u2014 \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E! "
  - "\u041B\u0430\u0434\u043D\u043E, \u0431\u0435\u0440\u0443 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u043C\u043D\u043E\u0433\u043E!"
  - "\u0423\u0434\u0430\u0447\u0438!"
  - 
