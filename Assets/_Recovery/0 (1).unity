  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u043E\u043F\u043B\u0438\u0432\u043E \u043A\u0443\u043F\u0438\u043B. \u0410
    \u0433\u0434\u0435 \u0432\u043E\u043E\u0431\u0449\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u043A \u0432\u044B\u043B\u0435\u0442\u0443?"
  - "\u0415\u0441\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \"\u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438\"."
  - "\u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043C \u0432\u0441\u0451 \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440: \u0432 \u043D\u0435\u0439 \u0442\u044B
    \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u043B\u0438\u0442\u044C \u0442\u043E\u043F\u043B\u0438\u0432\u043E
    \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043B\u0451\u0442! "
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
