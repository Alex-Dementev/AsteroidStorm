--- !u!114 &1210540596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1210540594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0430\u043A... \u0441\u0442\u043E\u043F. \u0423 \u043C\u0435\u043D\u044F
    \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u043E\u043B\u044C. \u0414\u0430\u0436\u0435
    \u043D\u0430 \u0431\u043E\u043B\u0442 \u0434\u0435\u043D\u0435\u0433 \u043D\u0435\u0442!"
  - "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E? \u0422\u044B \u043B\u0435\u0442\u0435\u0442\u044C
    \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F, \u0430 \u043A\u043E\u0448\u0435\u043B\u0451\u043A
    \u0434\u043E\u043C\u0430 \u0437\u0430\u0431\u044B\u043B? "
  - "\u0423 \u043C\u0435\u043D\u044F \u0432\u0441\u0451 \u0432\u043B\u043E\u0436\u0435\u043D\u043E
    \u0432 \u0430\u043F\u0433\u0440\u0435\u0439\u0434\u044B. \u0414\u0435\u043D\u0435\u0433
    \u2014 \u043C\u0438\u043D\u0443\u0441! "
  - "\u041B\u0430\u0434\u043D\u043E, \u043D\u0435 \u043E\u0440\u0438\u0442\u0435.
    \u041B\u043E\u0432\u0438, \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C
    46 \u043C\u043E\u043D\u0435\u0442. \u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439
    \u043E\u0442\u043A\u0443\u0434\u0430..."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043D\u043E \u0442\u0443\u0440\u0431\u0438\u043D\u0430
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0442\u043E\u0438\u0442. \u042D\u0442\u043E
    \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0438 \u043E \u0447\u0451\u043C!"
  - "\u0411\u043E\u0436\u0435, \u0442\u044B \u043A\u0430\u043A \u0440\u0435\u0431\u0451\u043D\u043E\u043A.
    \u0412\u043E\u0437\u044C\u043C\u0438 \u043A\u0440\u0435\u0434\u0438\u0442 \u0438
    \u043D\u0435 \u0432\u044B\u043D\u043E\u0441\u0438 \u043D\u0430\u043C \u043C\u043E\u0437\u0433!"
  - "\u041D\u0443, \u0442\u0443\u0442 \u0432\u0441\u0451 \u044F\u0441\u043D\u043E.
    \u0411\u0435\u0440\u0451\u0448\u044C \u043A\u0440\u0435\u0434\u0438\u0442 \u0438
    \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0448\u044C \u0432\u0441\u0451, \u0447\u0442\u043E
    \u043D\u0443\u0436\u043D\u043E! \u041F\u043E\u0442\u043E\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F,
    \u0447\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435. "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
  - "\u0420\u043E\u043C\u0430"
  - "\u041D\u0438\u043A\u0438\u0442\u0430"
  - "\u0410\u043B\u0438\u0441\u0430"
