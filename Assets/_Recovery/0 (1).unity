--- !u!114 &819531261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 819531259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F."
  - "\u0423\u0436\u0435? \u0422\u044B \u043C\u043D\u043E\u0433\u043E \u043C\u0435\u0442\u0430\u043B\u043B\u0430
    \u0441\u043E\u0431\u0440\u0430\u043B?"
  - "\u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043B.
    \u0422\u0440\u0443\u0434\u043D\u043E \u0438\u0445 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C. "
  - "\u041A\u0441\u0442\u0430\u0442\u0438, \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043E\u0434\u0433\u043E\u043D
    \u0434\u043B\u044F \u0442\u0435\u0431\u044F. \u041C\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438
    \u0442\u0435\u0431\u0435 80 \u043C\u043E\u043D\u0435\u0442! \u041D\u0443, \u043F\u0440\u043E\u0441\u0442\u043E
    \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0440\u0442\u0430\u043D\u0443\u0442\u044C! "
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
