--- !u!114 &2107789938
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2107789936}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0427\u0451\u0440\u0442\u2026 \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u043A\u0443\u043F\u0438\u043B,
    \u0430 \u0437\u0430\u043B\u0438\u0442\u044C \u0435\u0433\u043E \u043D\u0435\u043A\u0443\u0434\u0430! "
  - "\u0411\u0430\u043A \u2014 \u043D\u0435\u0442, \u044D\u0442\u043E \u0436\u0435
    \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E! \u041F\u0440\u043E\u0441\u0442\u043E
    \u043A\u0443\u043F\u0438 \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0435\u0433\u043E. "
  - "\u0422\u043E \u0435\u0441\u0442\u044C \u044F \u043E\u043F\u044F\u0442\u044C
    \u043D\u0435 \u0433\u043E\u0442\u043E\u0432?"
  - "\u0414\u0430. \u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E."
  - "\u041A\u0443\u043F\u0438 \xAB\u0411\u0430\u043A 1\xBB, \u0438 \u043F\u043E\u0434
    \u043D\u0435\u0433\u043E \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u0435\u043D
    \u0441\u043B\u043E\u0442. "
  - "\u0423\u0447\u0442\u0438, \u0431\u0430\u043A \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u0435\u043D
    \u2014 \u043E\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0442\u043E\u043F\u043B\u0438\u0432\u0430! "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
