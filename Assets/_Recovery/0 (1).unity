--- !u!114 &1830523488
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1830523486}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F..."
  - "\u041A\u0440\u0443\u0442\u043E! \u0422\u044B \u043C\u043D\u043E\u0433\u043E
    \u043C\u0435\u0442\u0430\u043B\u043B\u0430 \u0441\u043E\u0431\u0440\u0430\u043B?
    \u041F\u043E\u0434\u043E\u0436\u0434\u0438\u2026 \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B? "
  - "\u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F... \u041E\u043D\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0431\u044B\u0441\u0442\u0440\u043E \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u043B\u0438\u0441\u044C..."
  - "\u0422\u044B, \u043D\u0435\u0431\u043E\u0441\u044C, \u043A\u0430\u0436\u0434\u044B\u0439
    \u0440\u0430\u0437 \u0434\u0435\u0440\u0433\u0430\u043B\u0441\u044F \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442? "
  - "\u041D\u0430 \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
