--- !u!114 &1639402638
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1639402636}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439, \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
    \u043F\u043E\u043B\u0451\u0442. \u041C\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u043C
    \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0442\u044B \u0432\u044B\u043B\u0435\u0442\u0438\u0448\u044C, \u2014 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
    \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F. \u0422\u0430\u043A
    \u0447\u0442\u043E \u0437\u0430\u0434\u0430\u0432\u0430\u0439 \u0432\u043E\u043F\u0440\u043E\u0441\u044B. "
  - "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E-\u0442\u043E
    \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u043F\u043E\u043B\u0435\u0442\u0430 \u043A\u0440\u043E\u043C\u0435 \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u044F
    \u043E\u0442 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043E\u0432?"
  - "\u0414\u0430. \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
    - \u044D\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
    \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u044B. \u0416\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441 \u043C\u0435\u0442\u0430\u043B\u043B\u0430\u043C\u0438, \u0442\u044B \u0438\u0445
    \u0443\u0437\u043D\u0430\u0435\u0448\u044C."
  - "\u041C\u0435\u0442\u0430\u043B\u043B\u044B \u0442\u044B \u043F\u043E\u0442\u043E\u043C
    \u0441\u0434\u0430\u0448\u044C \u0438 \u043F\u0443\u0441\u0442\u0438\u0448\u044C
    \u043D\u0430 \u0430\u043F\u0433\u0440\u0435\u0439\u0434\u044B!"
  - "\u0410 \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u0430\u043C\u0438
    \u0447\u0442\u043E?"
  - "\u0412 \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043D\u0435 \u043B\u0435\u0437\u044C,
    \u0443 \u0442\u0435\u0431\u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435\u0442
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430\u0449\u0438\u0442\u044B
    \u043E\u0442 \u043D\u0438\u0445."
  - "\u041A\u0441\u0442\u0430\u0442\u0438, \u0442\u0435\u0431\u0435 \u043F\u043E
    \u043F\u0443\u0442\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043F\u0430\u0434\u0430\u0442\u044C\u0441\u044F
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B,
    \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A: \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u0430,
    \u044D\u043D\u0435\u0440\u0433\u043E-\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
    \u0438 \u0433\u0430\u0435\u0447\u043D\u044B\u0439 \u043A\u043B\u044E\u0447. \u0412\u043F\u0440\u043E\u0447\u0435\u043C,
    \u043F\u043E\u0442\u043E\u043C \u0441\u0430\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u0448\u044C\u0441\u044F. "
  - "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u043B\u0435\u0442\u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E,
    \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u043C\u0435\u043B\u043E\u0447\u044C.
    \u0415\u0441\u043B\u0438 \u0440\u0430\u043A\u0435\u0442\u0430 \u0432\u0437\u043E\u0440\u0432\u0451\u0442\u0441\u044F,
    \u0442\u0435\u0431\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u044F\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E,
    \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044F \u0442\u043E\u043F\u043B\u0438\u0432\u043E
    \u0432\u0440\u044F\u0434 \u043B\u0438 \u0432\u0435\u0440\u043D\u0451\u0448\u044C
    \u2014 \u0442\u0430\u043C \u0448\u0430\u043D\u0441 1 \u043A 1. "
  - "\u0423\u0434\u0430\u0447\u0438!"
  - 
  - 
  - 
  - 
  - 
