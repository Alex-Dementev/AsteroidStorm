    \u0437\u0430\u0434\u0430\u043D\u0438\u0439. \u0418 \u0447\u0442\u043E \u0442\u0443\u0442?"
  - "\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u044F
    \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B. \u042D\u0442\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F
    \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E.
    \u042D\u0442\u043E \u043A\u0430\u043A-\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442
    \u043C\u043E\u0434\u0443\u043B\u0438."
  - "\u041D\u0443 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430
    \u043C\u043E\u0434\u0443\u043B\u0438. \u0422\u0430\u043C \u0441\u0430\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F."
  - "\u0412\u043E\u0442 \u0438\u0445 \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C, \u043E\u043D\u0438 \u043E\u0447\u0435\u043D\u044C
    \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u0440\u0430\u043A\u0435\u0442\u0443!"
  - "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0439
    \u0438\u0445. "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
