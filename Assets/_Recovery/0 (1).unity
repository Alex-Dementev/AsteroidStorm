--- !u!114 &1305433593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1305433592}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u0422\u0443\u0442 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u0438\u0442\u043E\u043C\u0446\u044B. \u042D\u0442\u043E\u2026 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E? "
  - "\u0421\u043E\u0433\u043B\u0430\u0441\u0435\u043D. \u041C\u0435\u0442\u0430\u043B\u043B,
    \u043D\u043E \u043A\u0430\u043A \u0436\u0438\u0432\u043E\u0439\u2026 \u042F \u0434\u043E
    \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
    \u043A\u0430\u043A \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u2026 "
  - "\u0417\u0430\u0442\u043E \u043E\u043D\u0438 \u043C\u0438\u043B\u044B\u0435!
    \u041C\u043D\u0435 \u044D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
  - "\u041E\u043D\u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0435
    \u0438\u043C\u0435\u044E\u0442 \u043F\u043E\u043B\u044C\u0437\u044B. \u041D\u043E
    \u043E\u043D\u0438 \u043A\u0430\u043A \u0441\u0442\u0430\u0442\u0443\u0441: \u0434\u043E\u0440\u043E\u0433\u0438\u0435
    \u0438 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435. "
  - "\u041D\u0430 \u044D\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E
    \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u044B.
    \u041D\u0443 \u0442\u044B \u043A\u0443\u043F\u0438\u043B \u2014 \u0438 \u0447\u0442\u043E,
    \u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044C\u0437\u044B? "
  - "\u041D\u0435 \u0437\u043D\u0430\u044E\u2026 \u041D\u043E \u0434\u043E\u043B\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C, \u043E\u043D\u0438 \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u044F\u0442\u2026 "
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
