--- !u!114 &1450500511
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1450500509}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1833e10d06372a34a9f0b7f7a8066a46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u041F\u0440\u0438\u043A\u043E\u043B! \u042F \u0437\u0430\u0448\u0451\u043B
    \u043A\u0443\u0434\u0430-\u0442\u043E, \u0430 \u0442\u0443\u0442 \u043C\u043E\u0436\u043D\u043E
    \u043C\u0435\u043D\u044F\u0442\u044C \u0432\u044B\u0445\u043B\u043E\u043F \u0440\u0430\u043A\u0435\u0442\u044B! "
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u042F \u043C\u0438\u043C\u043E
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B \u0438 \u043F\u043E\u0434\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C\u0438. "
  - "\u041A\u0430\u043A \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0442\u0443\u0442
    \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044F\u0442\u044C \u0446\u0432\u0435\u0442
    \u0438 \u0434\u043B\u0438\u043D\u0443 \u0432\u044B\u0445\u043B\u043E\u043F\u0430! "
  - "\u0425\u043C, \u0447\u0438\u0441\u0442\u043E \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u043A\u0430,
    \u043D\u0443, \u043D\u0435\u043F\u043B\u043E\u0445\u043E..."
  - "\u0414\u0430 \u043D\u0443 \u043D\u0430\u0444\u0438\u0433... \u043B\u0435\u0442\u0430\u0442\u044C
    \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435 \u043D\u0435
    \u0441\u0442\u0430\u043D\u0435\u0442."
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
