  m_Name: 
  m_EditorClassIdentifier: 
  Dialogue:
  - "\u041A\u0441\u0442\u0430\u0442\u0438, \u0442\u044B \u0443\u0436\u0435 \u043B\u0443\u0447\u0448\u0435
    \u043B\u0435\u0442\u0430\u0442\u044C \u0441\u0442\u0430\u043B."
  - "\u041F\u0440\u0438\u0432\u044B\u043A. "
  - "\u042D\u0442\u043E \u0432\u0438\u0434\u043D\u043E. \u0420\u0430\u043D\u044C\u0448\u0435
    \u0434\u0435\u0440\u0433\u0430\u043B\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435..."
  - "\u0422\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u0448\u0435\u043B
    \u043A \u0437\u0430\u0434\u0430\u043D\u0438\u044F\u043C. \u041C\u043E\u0436\u0435\u0448\u044C
    \u0438\u0445 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C, \u0430 \u043C\u043E\u0436\u0435\u0448\u044C
    \u0438 \u0437\u0430\u0431\u0438\u0442\u044C."
  - "\u041E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u043A \u043F\u043E\u0431\u043E\u0447\u043A\u0430."
  - "\u041F\u0440\u043E\u0441\u0442\u043E \u0438\u043C\u0435\u0439 \u0432 \u0432\u0438\u0434\u0443,
    \u0447\u0442\u043E \u043E\u043D\u0438 \u0435\u0441\u0442\u044C! "
